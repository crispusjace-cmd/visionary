# ─── SERVER ───────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE ─────────────────────────────────
# After installing PostgreSQL, create a database called visionary_school
# Then fill in your credentials below
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visionary_school
DB_USER=postgres
DB_PASSWORD=2580

# ─── JWT ──────────────────────────────────────
# Change this to a long random string in production!
JWT_SECRET=visionary_school_super_secret_key_2026
JWT_EXPIRES_IN=7d

# ─── FRONTEND ─────────────────────────────────
# URL of your frontend (for CORS)
CLIENT_URL=http://localhost:3000
